NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/coachify_demo
JWT_SECRET=replace-with-at-least-32-random-bytes
CORS_ORIGINS=http://localhost:5173

# Development-only mock gateway. Never use for real or production payments.
MOCK_GATEWAY_SECRET=replace-with-a-development-only-random-secret

# Required to issue receipts. GST remains unconfigured until taxability is confirmed.
INSTITUTE_NAME=
INSTITUTE_ADDRESS=
INSTITUTE_GST_TAXABILITY=NOT_CONFIGURED
INSTITUTE_GST_RATE_BPS=
INSTITUTE_GST_TREATMENT=

# Demo seeding remains disabled unless deliberately enabled in development.
DEMO_SEED_ENABLED=false
DEMO_OTP_ENABLED=false
DEMO_PARENT_PHONES=9000000412,9000000587,9000000219
DEMO_ACCOUNTS_PASSWORD=
DEMO_PARENT_PASSWORD=
DEMO_COUNSELLOR_PASSWORD=
